# Пример настроек. Для запуска ничего копировать не нужно: у всех переменных есть значения по умолчанию.
# Чтобы переопределить, скопируйте файл в `.env` (он не попадает в репозиторий).

# Строка подключения к БД (SQLAlchemy, async-драйвер).
# По умолчанию — файл SQLite; каталог создаётся автоматически.
DATABASE_URL=sqlite+aiosqlite:///./data/tickets.db

# Демо-режим: включает панель и эндпоинты /api/demo/* (занять места, сбросить остаток).
# Нужен для показа сценария «места закончились до подтверждения».
# Для публичного развёртывания выключить (false).
DEMO_MODE=true

# Разрешённые источники запросов через запятую (CORS).
# Пусто — CORS выключен: фронтенд и API работают с одного адреса (nginx в Docker или прокси Vite).
# Нужно только если фронтенд открывается с другого адреса, например: http://localhost:5173
CORS_ORIGINS=

# Общее число мест мероприятия при первом создании (seed).
# Небольшое значение удобно для демонстрации нехватки мест.
EVENT_TOTAL_SEATS=10
